{
  "name": "@chief-agent/pi-runtime",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Independent Pi-based learn, plan and approved-build runtime",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./report": "./dist/report.js"
  },
  "bin": {
    "pi-runtime": "./dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "kite run build && kite test",
    "format:check": "prettier --check src tests README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
