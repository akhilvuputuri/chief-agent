# Copy to .env; never commit real credentials.
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgres://companion:replace-with-random-password@localhost:5432/companion
TELEGRAM_BOT_TOKEN=
# Numeric user IDs, comma separated. Only their private chats are accepted.
TELEGRAM_ALLOWED_USER_IDS=
AGENT_MODEL=openai/gpt-5.6-sol
AGENT_REASONING_EFFORT=medium
# Maximum USD per million tokens for driver routing (not a total task budget).
OPENROUTER_MAX_INPUT_PRICE=2
OPENROUTER_MAX_OUTPUT_PRICE=10
SEARCH_MODEL=google/gemini-3.8-flash
OPENROUTER_API_KEY=
# Voice only; model API remains independently configurable.
STT_PROVIDER=openai
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
VOICE_REPLIES=false
# Optional read-only search / page extraction provider.
TAVILY_API_KEY=
PORT=3000

# Optional read-only Gmail; owner is one paired Telegram numeric user ID.
GMAIL_OWNER_USER_ID=
GMAIL_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Separate app-created Google Sheet access; Gmail stays read-only.
SHEETS_OWNER_USER_ID=
SHEETS_REFRESH_TOKEN=
SHEETS_SPREADSHEET_ID=

# Separate read-only Calendar credential and daily-life viewing workbook
CALENDAR_REFRESH_TOKEN=
DAILY_SPREADSHEET_ID=

# Per-task allocation; /continue adds another allocation without resetting work
AGENT_BUDGET_MS=900000
AGENT_BUDGET_MODEL_CALLS=40
AGENT_BUDGET_TOOL_CALLS=100
