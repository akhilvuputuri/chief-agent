# Exact static information routes; private API authorization is unchanged.
companion.52-77-47-24.sslip.io {
  header {
    -Server
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    Cache-Control no-store
  }
  @info path /about /privacy /terms
  handle @info {
    root * /var/www/companion-oauth
    rewrite /about /index.html
    rewrite /privacy /privacy.html
    rewrite /terms /terms.html
    file_server
  }
  @mini path /miniapp/ /miniapp/app.js /miniapp/app.css /api/miniapp/*
  handle @mini {
    reverse_proxy 127.0.0.1:3000
  }
  handle / {
    redir /miniapp/ 302
  }
  handle {
    respond "Not found" 404
  }
}
