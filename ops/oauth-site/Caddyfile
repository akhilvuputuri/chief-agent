# Exact static information routes; private API authorization is unchanged.
companion.52-77-47-24.sslip.io {
  header {
    -Server
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    Cache-Control no-store
  }
  @info path /about /privacy /terms
  handle @info {
    root * /var/www/companion-oauth
    rewrite /about /index.html
    rewrite /privacy /privacy.html
    rewrite /terms /terms.html
    file_server
  }
  @mini path /miniapp/ /miniapp/app.js /miniapp/app.css /api/miniapp/*
  handle @mini {
    reverse_proxy 127.0.0.1:3000
  }
  # Read-only IBKR OAuth redirect (issue #146); the gateway validates single-use state.
  @ibkr path /oauth/ibkr/callback
  handle @ibkr {
    reverse_proxy 127.0.0.1:3000
  }
  handle / {
    redir * /miniapp/ 302
  }
  handle {
    respond "Not found" 404
  }
}

# agentwatch, the trace viewer (docs/tracing.md#viewing-traces-from-anywhere). agentwatch
# requires signing in; OTLP ingest stays on the Compose network.
traces.52-77-47-24.sslip.io {
  header {
    -Server
    # Not no-referrer: under it browsers send `Origin: null` with writes and the sign-in
    # form, which agentwatch refuses as cross-site.
    Referrer-Policy same-origin
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
  }
  header /api/* Cache-Control no-store
  @ingest path /v1/*
  handle @ingest {
    respond "Not found" 404
  }
  handle {
    reverse_proxy 127.0.0.1:4318
  }
}
