# Only the reviewed static Mini App and authenticated read-only API are public.
companion.188-166-246-143.sslip.io {
	header {
		-Server
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Cache-Control no-store
	}
	@mini path /miniapp/ /miniapp/app.js /miniapp/app.css /api/miniapp/*
	handle @mini {
		reverse_proxy 127.0.0.1:3000
	}
	handle / {
		redir /miniapp/ 302
	}
	handle {
		respond "Not found" 404
	}
}
