{
  "agent": {
    "region": "ap-southeast-1",
    "run_as_user": "root",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/chief/gateway.jsonl",
            "log_group_name": "/chief/prod/runtime",
            "log_stream_name": "lightsail-gateway",
            "timezone": "UTC",
            "retention_in_days": -1,
            "timestamp_format": "%Y-%m-%dT%H:%M:%S"
          },
          {
            "file_path": "/var/log/chief/host-health.jsonl",
            "log_group_name": "/chief/prod/host",
            "log_stream_name": "lightsail-host",
            "timezone": "UTC",
            "retention_in_days": -1,
            "timestamp_format": "%Y-%m-%dT%H:%M:%S"
          }
        ]
      }
    }
  }
}
