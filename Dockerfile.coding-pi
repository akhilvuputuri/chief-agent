FROM node:22.23.4-bookworm-slim AS node
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev git ripgrep ca-certificates util-linux && rm -rf /var/lib/apt/lists/* && groupadd -g 1000 worker && useradd -m -u 1000 -g 1000 worker
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/include/node /usr/local/include/node
# Node without npm: installs use the pinned, checksum-verified lockstep.
COPY tools/lockstep.json tools/install-lockstep.mjs /opt/lockstep/
RUN node /opt/lockstep/install-lockstep.mjs --dir /usr/local/bin
WORKDIR /opt/chief-worker
COPY package*.json ./
COPY coding_runtime_pi ./coding_runtime_pi
RUN lockstep ci --ignore-scripts
COPY tsconfig*.json ./
COPY src ./src
RUN lockstep run build && mkdir -p /opt/pi-runtime && gcc -shared -fPIC -I/usr/local/include/node coding_runtime_pi/native/process.c -o /opt/pi-runtime/process-boundary.node
COPY coding_runtime/requirements-dev.txt /opt/pi-runtime/requirements-dev.txt
RUN pip install --no-cache-dir --require-hashes -r /opt/pi-runtime/requirements-dev.txt
USER worker
CMD ["node", "--disable-sigusr1", "/opt/chief-worker/dist/coding/pi-worker.js"]
