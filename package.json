{
  "name": "chief-agent",
  "version": "0.3.41",
  "private": true,
  "type": "module",
  "description": "A personal AI assistant with an owned TypeScript runtime, Telegram voice, memory, research and durable tasks",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.evals.json",
    "test": "npm run build && tsx --test tests/*.test.ts && node --test scripts/*.test.mjs && python3 -m unittest discover -s evals/picker -p 'test_*.py' && python3 -m unittest discover -s evals/context -p 'test_*.py' && python3 -m unittest discover -s evals/decisions -p 'test_*.py'",
    "migrate": "tsx src/migrate.ts",
    "check": "npm run typecheck && npm test && npm run check:coding",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "check:env": "node scripts/check-env.mjs",
    "pair": "node scripts/pair-telegram.mjs",
    "pair:finish": "node scripts/pair-telegram.mjs --finish",
    "smoke:runtime": "tsx scripts/smoke-custom.ts",
    "eval": "tsx evals/run.ts",
    "eval:compare": "tsx evals/compare.ts",
    "eval:picker": "python3 evals/picker/run.py",
    "eval:context": "python3 evals/context/run.py",
    "eval:decisions": "python3 evals/decisions/run.py",
    "doctor:cloud": "node scripts/cloud-doctor.mjs",
    "plugins": "node --import tsx src/plugin-cli.ts",
    "release:status": "node scripts/release-status.mjs",
    "logs:cloudwatch": "node scripts/cloudwatch-logs.mjs",
    "context:inventory": "tsx scripts/context-inventory.ts",
    "check:coding": "python3 -m ruff check coding_runtime && python3 -m ruff format --check coding_runtime && python3 -m mypy coding_runtime/src --strict && PYTHONPATH=coding_runtime/src python3 -m unittest discover -s coding_runtime/tests -v"
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "3.1141.0",
    "@aws-sdk/client-sts": "3.1141.0",
    "@fastify/websocket": "11.3.2",
    "@grammyjs/runner": "^2.0.3",
    "cron-parser": "^5.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "grammy": "^1.35.0",
    "https-proxy-agent": "9.1.0",
    "pg": "^8.13.3",
    "playwright-core": "1.63.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1141.0",
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
