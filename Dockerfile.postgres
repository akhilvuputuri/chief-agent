# Postgres with pgvector, on the exact Alpine image production already ran. The compiler stays in
# the build stage, whose package upgrades (it moves musl) never reach the final image: that holds
# the base's binaries, libc and collation plus pgvector's files (docs/recall.md).
# A change here needs a new image tag in compose.yaml and an operator rollout: no check catches it.
FROM postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24 AS build
ADD --checksum=sha256:cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85 https://github.com/pgvector/pgvector/archive/refs/tags/v0.8.7.tar.gz /tmp/pgvector.tar.gz
# with_llvm=no: no JIT bitcode, so no clang or LLVM headers. OPTFLAGS empty: no -march=native,
# so the image runs on any x86_64 host, not only the one that built it.
RUN apk add --no-cache build-base \
  && mkdir /tmp/pgvector && tar -xzf /tmp/pgvector.tar.gz -C /tmp/pgvector --strip-components=1 \
  && make -C /tmp/pgvector OPTFLAGS="" with_llvm=no install

FROM postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
COPY --from=build /usr/local/lib/postgresql/vector.so /usr/local/lib/postgresql/
COPY --from=build /usr/local/share/postgresql/extension/vector* /usr/local/share/postgresql/extension/
