FROM node:22.23.4-bookworm-slim AS build
# kite replaces npm (pinned and checksum-verified in tools/kite.json);
# npm itself is removed so nothing can fall back to it.
COPY tools/kite.json tools/install-kite.mjs /opt/kite/
RUN node /opt/kite/install-kite.mjs --dir /usr/local/bin && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY package*.json ./
COPY coding_runtime_pi ./coding_runtime_pi
RUN kite ci
COPY tsconfig.json ./
COPY src ./src
RUN kite run build && kite ci --omit=dev

FROM node:22.23.4-bookworm-slim AS proxy
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY package.json ./
COPY --from=build /app/dist/security.js ./dist/security.js
COPY --from=build /app/dist/browser/policy.js /app/dist/browser/proxy.js ./dist/browser/
USER node
CMD ["node", "dist/browser/proxy.js"]

FROM node:22.23.4-bookworm-slim AS browser
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist/browser ./dist/browser
COPY --from=build /app/dist/security.js ./dist/security.js
COPY --from=build /app/dist/gathering/facts.js ./dist/gathering/facts.js
COPY scripts/browser-smoke.mjs ./browser-smoke.mjs
ENV XDG_CONFIG_HOME=/tmp/chromium-config XDG_CACHE_HOME=/tmp/chromium-cache
USER node
CMD ["node", "dist/browser/service.js"]
