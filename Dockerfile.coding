FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 worker && useradd -m -u 1000 -g 1000 worker
COPY --from=node /usr/local/bin/node /usr/local/bin/node
# Node without npm: tasks install with the pinned, checksum-verified kite.
COPY tools/kite.json tools/install-kite.mjs /opt/kite/
RUN node /opt/kite/install-kite.mjs --dir /usr/local/bin
WORKDIR /opt/chief-worker
COPY coding_runtime/requirements-dev.txt ./requirements-dev.txt
RUN pip install --no-cache-dir --require-hashes -r requirements-dev.txt
COPY coding_runtime ./package
RUN pip install --no-cache-dir --no-deps --no-build-isolation ./package && rm -rf ./package
USER worker
CMD ["python", "-I", "-m", "chief_coding_runtime.worker"]
